# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=MadrastekDz
APP_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Set USE_MEMORY_DB=true to use in-memory MongoDB (no external service needed)
USE_MEMORY_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017/madrastekdz
# Increase if mongodb-memory-server times out on first launch (Windows / antivirus)
MONGOMS_LAUNCH_TIMEOUT_MS=120000

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_super_secret_jwt_key_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change_me_session_secret_min_32_chars

# ─── Mailer ───────────────────────────────────────────────────────────────────
# Set MAIL_LOG_ONLY=true to skip SMTP and just log + save emails to /tmp/emails/
MAIL_LOG_ONLY=true
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_ethereal_user
MAIL_PASS=your_ethereal_pass
MAIL_FROM="MadrastekDz <noreply@madrastekdz.com>"

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_PATH=public/uploads
MAX_FILE_SIZE_MB=10

# ─── i18n ─────────────────────────────────────────────────────────────────────
DEFAULT_LANG=fr

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
