<!DOCTYPE html>
<html lang="<%= locals.lang || 'fr' %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Super Admin | MadrastekDz</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"><style>body{font-family:Inter,sans-serif;background:#f8fafc;margin:0}</style></head>
<body>
<nav class="bg-white shadow-sm py-2"><div class="container d-flex justify-content-between align-items-center">
<a href="/super/dashboard" class="text-decoration-none fw-bold fs-5"><span style="color:#dc2626">⚡ Super</span> · MadrastekDz</a>
<div class="d-flex gap-2"><a href="/super/schools" class="btn btn-sm btn-light">Écoles</a><a href="/super/subscriptions" class="btn btn-sm btn-light">Abonnements</a><a href="/super/plans" class="btn btn-sm btn-light">Formules</a><a href="/auth/logout" class="btn btn-sm btn-outline-danger">Déconnexion</a></div>
</div></nav>
<div class="container py-4">
<% if (locals.flashSuccess && flashSuccess.length) { %><div class="alert alert-success"><%= flashSuccess[0] %></div><% } %>
<h3 class="fw-bold mb-3">Tableau de bord Super Admin</h3>
<div class="row g-3 mb-4">
<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Écoles</div><div class="fw-bold fs-3"><%= stats.totalSchools %></div></div></div></div>
<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Abonnements actifs</div><div class="fw-bold fs-3"><%= stats.activeSubscriptions %></div></div></div></div>
<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Formules</div><div class="fw-bold fs-3"><%= stats.totalPlans %></div></div></div></div>
<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Utilisateurs</div><div class="fw-bold fs-3"><%= stats.totalUsers %></div></div></div></div>
</div>
<div class="card border-0 shadow-sm"><div class="card-body"><h6 class="fw-bold mb-3">Écoles récentes</h6><table class="table mb-0"><thead class="bg-light"><tr><th>Nom</th><th>Type</th><th>Statut</th><th>Créée le</th><th></th></tr></thead><tbody>
<% recentSchools.forEach(s => { %><tr><td class="fw-medium"><%= s.name %></td><td><%= s.type %></td><td><% if (s.isLocked) { %><span class="badge bg-danger">Verrouillée</span><% } else { %><span class="badge bg-success">Active</span><% } %></td><td class="small"><%= new Date(s.createdAt).toLocaleDateString('fr-FR') %></td><td><a href="/super/schools/<%= s._id %>" class="btn btn-sm btn-primary">Voir</a></td></tr><% }) %>
</tbody></table></div></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
