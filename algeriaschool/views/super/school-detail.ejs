<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title><%= school.name %></title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"><style>body{font-family:Inter,sans-serif;background:#f8fafc}</style></head>
<body><nav class="bg-white shadow-sm py-2"><div class="container d-flex justify-content-between"><a href="/super/dashboard" class="text-decoration-none fw-bold fs-5"><span style="color:#dc2626">⚡ Super</span></a><a href="/auth/logout" class="btn btn-sm btn-outline-danger">Déconnexion</a></div></nav>
<div class="container py-4">
<% if (locals.flashSuccess && flashSuccess.length) { %><div class="alert alert-success"><%= flashSuccess[0] %></div><% } %>
<a href="/super/schools" class="btn btn-light btn-sm mb-3">← Retour</a>
<h3 class="fw-bold mb-3"><%= school.name %></h3>
<div class="row g-3">
<div class="col-md-8"><div class="card border-0 shadow-sm"><div class="card-body">
<h6 class="fw-bold mb-3">Infos école</h6>
<div class="row small g-2"><div class="col-md-6"><strong>Type:</strong> <%= school.type %></div><div class="col-md-6"><strong>Email:</strong> <%= school.email || '—' %></div><div class="col-md-6"><strong>Statut:</strong> <%= school.isLocked ? 'Verrouillée' : 'Active' %></div><div class="col-md-6"><strong>Utilisateurs:</strong> <%= users.length %></div></div>
<h6 class="fw-bold mt-4 mb-2">Abonnements</h6>
<table class="table table-sm"><thead><tr><th>Plan</th><th>Période</th><th>Statut</th><th>Début</th><th>Fin</th></tr></thead><tbody>
<% subscriptions.forEach(sub => { %><tr><td><%= sub.plan?.name %></td><td><%= sub.period %></td><td><%= sub.status %></td><td><%= new Date(sub.startDate).toLocaleDateString('fr-FR') %></td><td><%= new Date(sub.endDate).toLocaleDateString('fr-FR') %></td></tr><% }) %>
</tbody></table>
</div></div></div>
<div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body">
<h6 class="fw-bold mb-3">Actions</h6>
<% if (school.isLocked) { %>
<form action="/super/schools/<%= school._id %>/unlock" method="POST"><button class="btn btn-success w-100"><i class="fas fa-unlock me-2"></i>Déverrouiller</button></form>
<% } else { %>
<form action="/super/schools/<%= school._id %>/lock" method="POST"><button class="btn btn-danger w-100"><i class="fas fa-lock me-2"></i>Verrouiller</button></form>
<% } %>
</div></div></div>
</div>
</div></body></html>
