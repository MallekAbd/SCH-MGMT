<% portalType='parent'; portalLinks=[{href:'/parent/dashboard',match:'/dashboard',icon:'home',label:'Accueil'},{href:'/parent/grades',match:'/grades',icon:'star-half-alt',label:'Notes'},{href:'/parent/attendance',match:'/attendance',icon:'clipboard-check',label:'Présences'},{href:'/parent/invoices',match:'/invoices',icon:'file-invoice',label:'Factures'},{href:'/parent/messages',match:'/messages',icon:'envelope',label:'Messages'}]; %>
<%- include('../partials/portal-shell-start') %>
<div class="card border-0 mb-4" style="background:linear-gradient(135deg,#f59e0b,#06b6d4);border-radius:16px"><div class="card-body p-4 text-white"><h4 class="fw-bold mb-1">Bonjour, <%= user.firstName %> 👋</h4><p class="mb-0 opacity-75">Suivez la scolarité de vos enfants</p></div></div>
<h5 class="fw-bold mb-3">Mes enfants</h5>
<div class="row g-3 mb-4">
<% if (!students || !students.length) { %><div class="col-12 text-center text-muted py-4">Aucun enfant rattaché</div><% } %>
<% (students || []).forEach(s => { %><div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><div class="d-flex align-items-center gap-3 mb-3"><div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width:50px;height:50px;font-size:1.3rem"><%= s.firstName.charAt(0) %></div><div><h6 class="fw-bold mb-0"><%= s.firstName %> <%= s.lastName %></h6><span class="text-muted small"><%= s.currentClass?.name || '—' %></span></div></div><div class="row g-2 text-center small"><div class="col-4"><div class="bg-primary-subtle rounded p-2"><div class="fw-bold"><%= (s.avg||0).toFixed(1) %></div><div class="text-muted" style="font-size:0.7rem">Moyenne</div></div></div><div class="col-4"><div class="bg-success-subtle rounded p-2"><div class="fw-bold"><%= s.attendance || 100 %>%</div><div class="text-muted" style="font-size:0.7rem">Présence</div></div></div><div class="col-4"><div class="bg-warning-subtle rounded p-2"><div class="fw-bold"><%= s.balance || 0 %></div><div class="text-muted" style="font-size:0.7rem">Solde DA</div></div></div></div></div></div></div><% }) %>
</div>
<div class="row g-3">
<div class="col-md-12"><div class="card border-0 shadow-sm"><div class="card-body"><h6 class="fw-bold mb-3">Annonces de l'école</h6><% (announcements || []).forEach(a => { %><div class="border-bottom py-2"><strong class="small"><%= a.title %></strong><div class="text-muted" style="font-size:0.75rem"><%= new Date(a.createdAt).toLocaleDateString('fr-FR') %></div></div><% }) %><% if (!announcements || !announcements.length) { %><p class="text-muted small">Aucune annonce</p><% } %></div></div></div>
</div>
<%- include('../partials/portal-shell-end') %>
