<!DOCTYPE html>
<html lang="<%= locals.lang || 'fr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Créer un compte | AlgeriaSchool</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 50%, #f0fdf4 100%); min-height: 100vh; }
    .auth-card { border-radius: 20px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,.08); }
    .btn-primary { background: linear-gradient(135deg,#4f46e5,#6366f1); border: none; }
    .form-control:focus, .form-select:focus { border-color: #4f46e5; box-shadow: 0 0 0 .2rem rgba(79,70,229,.15); }
  </style>
</head>
<body class="py-5">
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="text-center mb-4">
        <a href="/" class="text-decoration-none fs-3 fw-bold"><span style="background:linear-gradient(135deg,#4f46e5,#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent">Algeria</span><span style="color:#1e293b">School</span></a>
        <h5 class="mt-2 mb-1 fw-semibold">Créez votre espace école</h5>
        <p class="text-muted small">30 jours d'essai gratuit, sans carte bancaire</p>
      </div>
      <div class="card auth-card p-4">
        <% if (locals.flashError && flashError.length) { %>
        <div class="alert alert-danger rounded-2 py-2 small"><%= flashError[0] %></div>
        <% } %>
        <form action="/auth/register" method="POST">
          <h6 class="fw-semibold mb-3 text-muted small text-uppercase">Informations administrateur</h6>
          <div class="row g-3 mb-3">
            <div class="col-6"><label class="form-label fw-medium small">Prénom *</label><input type="text" name="firstName" class="form-control" required></div>
            <div class="col-6"><label class="form-label fw-medium small">Nom *</label><input type="text" name="lastName" class="form-control" required></div>
          </div>
          <div class="mb-3"><label class="form-label fw-medium small">Email *</label><input type="email" name="email" class="form-control" required></div>
          <div class="mb-4">
            <label class="form-label fw-medium small">Mot de passe *</label>
            <input type="password" name="password" class="form-control" required minlength="8" placeholder="Min. 8 caractères">
          </div>
          <h6 class="fw-semibold mb-3 text-muted small text-uppercase">Informations de l'école</h6>
          <div class="mb-3"><label class="form-label fw-medium small">Nom de l'école *</label><input type="text" name="schoolName" class="form-control" required placeholder="Ex: École Excellence Alger"></div>
          <div class="mb-3">
            <label class="form-label fw-medium small">Type d'école</label>
            <select name="schoolType" class="form-select">
              <option value="preschool">Préscolaire</option>
              <option value="primary">École Primaire</option>
              <option value="middle">Collège / EMC</option>
              <option value="high">Lycée</option>
              <option value="university">Université</option>
              <option value="training">Centre de Formation</option>
              <option value="private" selected>École Privée</option>
            </select>
          </div>
          <% if (plans && plans.length) { %>
          <div class="mb-4">
            <label class="form-label fw-medium small">Formule (modifiable plus tard)</label>
            <div class="row g-2">
              <% plans.forEach((p, i) => { %>
              <div class="col-4">
                <input type="radio" name="planId" id="plan_<%= p._id %>" value="<%= p._id %>" class="btn-check" <%= i===0?'checked':'' %>>
                <label for="plan_<%= p._id %>" class="btn btn-outline-primary w-100 text-center py-2">
                  <div class="fw-bold small"><%= p.name %></div>
                  <div class="small text-muted"><%= p.prices.monthly.toLocaleString() %> DA/mois</div>
                </label>
              </div>
              <% }) %>
            </div>
          </div>
          <% } %>
          <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold">
            Créer mon espace école <i class="fas fa-arrow-right ms-2"></i>
          </button>
          <p class="text-center text-muted small mt-3 mb-0">Déjà un compte ? <a href="/auth/login" style="color:#4f46e5">Se connecter</a></p>
        </form>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
