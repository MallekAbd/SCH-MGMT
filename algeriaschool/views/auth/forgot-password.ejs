<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mot de passe oublié | AlgeriaSchool</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <style>body{font-family:Inter,sans-serif;background:linear-gradient(135deg,#f0f4ff,#faf5ff,#f0fdf4);min-height:100vh;display:flex;align-items:center}.card{border-radius:20px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.08)}</style>
</head>
<body>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="text-center mb-4">
        <a href="/" class="text-decoration-none fs-3 fw-bold"><span style="background:linear-gradient(135deg,#4f46e5,#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent">Algeria</span><span style="color:#1e293b">School</span></a>
      </div>
      <div class="card p-4">
        <h5 class="fw-bold mb-1">Mot de passe oublié</h5>
        <p class="text-muted small mb-4">Entrez votre email pour recevoir un lien de réinitialisation.</p>
        <% if (locals.flashSuccess && flashSuccess.length) { %><div class="alert alert-success small"><%= flashSuccess[0] %></div><% } %>
        <% if (locals.flashError && flashError.length) { %><div class="alert alert-danger small"><%= flashError[0] %></div><% } %>
        <form action="/auth/forgot-password" method="POST">
          <div class="mb-3"><label class="form-label fw-medium small">Email</label><input type="email" name="email" class="form-control" required placeholder="votre@email.com"></div>
          <button type="submit" class="btn btn-primary w-100 rounded-pill" style="background:linear-gradient(135deg,#4f46e5,#6366f1);border:none">Envoyer le lien</button>
        </form>
        <div class="text-center mt-3"><a href="/auth/login" class="small text-decoration-none" style="color:#4f46e5"><i class="fas fa-arrow-left me-1"></i>Retour à la connexion</a></div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
