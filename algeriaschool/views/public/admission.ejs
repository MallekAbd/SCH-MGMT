<!DOCTYPE html>
<html lang="<%= locals.lang || 'fr' %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"><link rel="stylesheet" href="/css/public.css"></head>
<body class="py-5" style="background:#f8fafc"><div class="container">
<div class="card border-0 shadow-sm p-4" style="max-width:800px;margin:auto">
<h2 class="fw-bold mb-1">Demande d'admission</h2>
<p class="text-muted mb-4"><%= school.name %></p>
<% if (locals.flashSuccess && flashSuccess.length) { %><div class="alert alert-success"><%= flashSuccess[0] %></div><% } %>
<form action="/admission/<%= school._id %>" method="POST" class="row g-3">
  <div class="col-md-6"><label class="form-label">Prénom de l'enfant *</label><input type="text" name="firstName" class="form-control" required></div>
  <div class="col-md-6"><label class="form-label">Nom *</label><input type="text" name="lastName" class="form-control" required></div>
  <div class="col-md-6"><label class="form-label">Date de naissance</label><input type="date" name="dateOfBirth" class="form-control"></div>
  <div class="col-md-6"><label class="form-label">Genre</label><select name="gender" class="form-select"><option value="male">Garçon</option><option value="female">Fille</option></select></div>
  <div class="col-md-6"><label class="form-label">Wilaya</label><input type="text" name="wilaya" class="form-control"></div>
  <div class="col-md-6"><label class="form-label">Adresse</label><input type="text" name="address" class="form-control"></div>
  <hr><h6 class="fw-bold">Informations parent</h6>
  <div class="col-md-6"><label class="form-label">Nom complet *</label><input type="text" name="parentName" class="form-control" required></div>
  <div class="col-md-6"><label class="form-label">Téléphone *</label><input type="tel" name="parentPhone" class="form-control" required></div>
  <div class="col-md-6"><label class="form-label">Email</label><input type="email" name="parentEmail" class="form-control"></div>
  <div class="col-md-6"><label class="form-label">Lien</label><select name="parentRelationship" class="form-select"><option value="father">Père</option><option value="mother">Mère</option><option value="guardian">Tuteur</option></select></div>
  <div class="col-md-6"><label class="form-label">Classe demandée</label><input type="text" name="applyingForClass" class="form-control"></div>
  <div class="col-md-6"><label class="form-label">Année scolaire</label><input type="text" name="academicYear" class="form-control" value="2024-2025"></div>
  <div class="col-12"><button type="submit" class="btn btn-primary px-5">Soumettre</button></div>
</form>
</div></div></body></html>
