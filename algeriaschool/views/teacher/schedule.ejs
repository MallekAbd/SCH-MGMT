<% portalType='teacher'; portalLinks=[{href:'/teacher/dashboard',match:'/dashboard',icon:'home',label:'Accueil'},{href:'/teacher/attendance',match:'/attendance',icon:'clipboard-check',label:'Présences'},{href:'/teacher/grades',match:'/grades',icon:'star-half-alt',label:'Notes'},{href:'/teacher/library',match:'/library',icon:'book',label:'Biblio'},{href:'/teacher/schedule',match:'/schedule',icon:'calendar',label:'Emploi du temps'},{href:'/teacher/messages',match:'/messages',icon:'envelope',label:'Messages'}]; %>
<%- include('../partials/portal-shell-start') %>
<h4 class="fw-bold mb-3">Mon emploi du temps</h4>
<div class="card border-0 shadow-sm"><div class="card-body p-0"><table class="table mb-0"><thead class="bg-light"><tr><th class="ps-3">Jour</th><th>Horaire</th><th>Matière</th><th>Classe</th><th>Salle</th></tr></thead><tbody>
<% if (!schedule || !schedule.length) { %><tr><td colspan="5" class="text-center text-muted py-4">Aucun cours planifié</td></tr><% } %>
<% (schedule || []).forEach(s => { %><tr><td class="ps-3"><%= ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'][s.dayOfWeek] %></td><td><%= s.startTime %> - <%= s.endTime %></td><td><%= s.course?.name %></td><td><%= s.class?.name %></td><td><%= s.room || '—' %></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../partials/portal-shell-end') %>
