<% portalType='teacher'; portalLinks=[{href:'/teacher/dashboard',match:'/dashboard',icon:'home',label:'Accueil'},{href:'/teacher/attendance',match:'/attendance',icon:'clipboard-check',label:'Présences'},{href:'/teacher/grades',match:'/grades',icon:'star-half-alt',label:'Notes'},{href:'/teacher/library',match:'/library',icon:'book',label:'Biblio'},{href:'/teacher/schedule',match:'/schedule',icon:'calendar',label:'Emploi du temps'},{href:'/teacher/messages',match:'/messages',icon:'envelope',label:'Messages'}]; %>
<%- include('../../partials/portal-shell-start') %>
<h4 class="fw-bold mb-3">Mes examens</h4>
<div class="card border-0 shadow-sm"><div class="card-body p-0"><table class="table mb-0"><thead class="bg-light"><tr><th class="ps-3">Examen</th><th>Matière</th><th>Classe</th><th>Date</th><th></th></tr></thead><tbody>
<% if (!exams || !exams.length) { %><tr><td colspan="5" class="text-center text-muted py-4">Aucun examen</td></tr><% } %>
<% (exams || []).forEach(e => { %><tr><td class="ps-3 fw-medium"><%= e.name %></td><td><%= e.course?.name %></td><td><%= e.class?.name %></td><td class="small"><%= e.date ? new Date(e.date).toLocaleDateString('fr-FR') : '—' %></td><td class="text-end pe-3"><a href="/teacher/grades/enter/<%= e._id %>" class="btn btn-sm btn-primary">Saisir</a></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../../partials/portal-shell-end') %>
