<% portalType='student'; portalLinks=[{href:'/student/dashboard',match:'/dashboard',icon:'home',label:'Accueil'},{href:'/student/grades',match:'/grades',icon:'star-half-alt',label:'Notes'},{href:'/student/attendance',match:'/attendance',icon:'clipboard-check',label:'Présences'},{href:'/student/schedule',match:'/schedule',icon:'calendar',label:'Emploi'},{href:'/student/library',match:'/library',icon:'book',label:'Biblio'},{href:'/student/invoices',match:'/invoices',icon:'file-invoice',label:'Factures'},{href:'/student/messages',match:'/messages',icon:'envelope',label:'Messages'}]; %>
<%- include('../../partials/portal-shell-start') %>
<h4 class="fw-bold mb-3">Mes notes</h4>
<div class="card border-0 shadow-sm mb-3"><div class="card-body"><h5 class="mb-1">Moyenne générale</h5><div class="display-5 fw-bold <%= (overall || 0)>=10?'text-success':'text-danger' %>"><%= (overall || 0).toFixed(2) %> / 20</div></div></div>
<div class="card border-0 shadow-sm"><div class="card-body p-0"><table class="table mb-0"><thead class="bg-light"><tr><th class="ps-3">Matière</th><th>Examen</th><th>Note</th><th>Date</th></tr></thead><tbody>
<% if (!grades || !grades.length) { %><tr><td colspan="4" class="text-center text-muted py-4">Aucune note</td></tr><% } %>
<% (grades || []).forEach(g => { %><tr><td class="ps-3 fw-medium"><%= g.course?.name %></td><td><%= g.exam?.name || '—' %></td><td><span class="fw-bold <%= g.score>=10?'text-success':'text-danger' %>"><%= g.score %>/<%= g.maxScore %></span></td><td class="small"><%= new Date(g.createdAt).toLocaleDateString('fr-FR') %></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../../partials/portal-shell-end') %>
