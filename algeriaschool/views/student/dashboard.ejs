<% portalType='student'; portalLinks=[{href:'/student/dashboard',match:'/dashboard',icon:'home',label:'Accueil'},{href:'/student/grades',match:'/grades',icon:'star-half-alt',label:'Notes'},{href:'/student/attendance',match:'/attendance',icon:'clipboard-check',label:'Présences'},{href:'/student/schedule',match:'/schedule',icon:'calendar',label:'Emploi'},{href:'/student/library',match:'/library',icon:'book',label:'Biblio'},{href:'/student/invoices',match:'/invoices',icon:'file-invoice',label:'Factures'},{href:'/student/messages',match:'/messages',icon:'envelope',label:'Messages'}]; %>
<%- include('../partials/portal-shell-start') %>
<div class="card border-0 mb-4" style="background:linear-gradient(135deg,#4f46e5,#06b6d4);border-radius:16px"><div class="card-body p-4 text-white"><h4 class="fw-bold mb-1">Bonjour, <%= user.firstName %> 👋</h4><p class="mb-0 opacity-75"><%= student?.currentClass?.name || 'Bienvenue dans votre espace étudiant' %></p></div></div>
<div class="row g-3 mb-4">
<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Moyenne</div><div class="fw-bold fs-3 <%= (stats?.avg || 0)>=10?'text-success':'text-danger' %>"><%= (stats?.avg || 0).toFixed(2) %></div></div></div></div>
<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Présence</div><div class="fw-bold fs-3 text-success"><%= stats?.attendance || 100 %>%</div></div></div></div>
<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Examens à venir</div><div class="fw-bold fs-3"><%= stats?.upcomingExams || 0 %></div></div></div></div>
<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Factures</div><div class="fw-bold fs-3"><%= stats?.invoices || 0 %></div></div></div></div>
</div>
<div class="row g-3">
<div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><h6 class="fw-bold mb-3">Annonces</h6><% (announcements || []).forEach(a => { %><div class="border-bottom py-2"><strong class="small"><%= a.title %></strong><div class="text-muted" style="font-size:0.75rem"><%= new Date(a.createdAt).toLocaleDateString('fr-FR') %></div></div><% }) %><% if (!announcements || !announcements.length) { %><p class="text-muted small">Aucune annonce</p><% } %></div></div></div>
<div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><h6 class="fw-bold mb-3">Mes derniers résultats</h6><% (recentGrades || []).forEach(g => { %><div class="border-bottom py-2 d-flex justify-content-between"><span class="small"><%= g.course?.name %></span><span class="badge bg-<%= g.score>=10?'success':'danger' %>-subtle text-<%= g.score>=10?'success':'danger' %>"><%= g.score %>/<%= g.maxScore %></span></div><% }) %><% if (!recentGrades || !recentGrades.length) { %><p class="text-muted small">Aucune note</p><% } %></div></div></div>
</div>
<%- include('../partials/portal-shell-end') %>
