<!DOCTYPE html>
<html lang="<%= locals.lang || 'fr' %>" dir="<%= locals.isRTL ? 'rtl' : 'ltr' %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | AlgeriaSchool</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
<% if (locals.isRTL) { %><link rel="stylesheet" href="/css/rtl.css"><% } %>
<style>
body{font-family:'Inter',sans-serif;background:#f8fafc;margin:0}
.portal-nav{background:white;box-shadow:0 1px 3px rgba(0,0,0,.04);position:sticky;top:0;z-index:100}
.portal-brand{font-weight:700;font-size:1.3rem}
.portal-brand .text-success{color:#22c55e!important}
.portal-link{color:#475569;text-decoration:none;padding:0.6rem 1rem;border-radius:8px;font-size:0.9rem;font-weight:500}
.portal-link:hover{background:#f1f5f9;color:#1e293b}
.portal-link.active{background:linear-gradient(135deg,#4f46e5,#6366f1);color:white}
</style>
</head>
<body>
<nav class="portal-nav py-2"><div class="container d-flex justify-content-between align-items-center">
<a href="/<%= portalType %>/dashboard" class="text-decoration-none portal-brand"><span class="text-success">Algeria</span><span style="color:#1e293b">School</span> · <%= {teacher:'Enseignant',student:'Étudiant',parent:'Parent'}[portalType] %></a>
<div class="d-flex gap-2 align-items-center">
<% (portalLinks || []).forEach(l => { %><a href="<%= l.href %>" class="portal-link <%= currentPath.includes(l.match)?'active':'' %>"><i class="fas fa-<%= l.icon %> me-1"></i><span class="d-none d-md-inline"><%= l.label %></span></a><% }) %>
<div class="dropdown"><button class="btn btn-sm btn-light dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown"><div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:30px;height:30px;font-size:0.8rem"><%= user.firstName.charAt(0).toUpperCase() %></div><span class="d-none d-md-inline small"><%= user.firstName %></span></button>
<ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item text-danger" href="/auth/logout"><i class="fas fa-sign-out-alt me-2"></i>Déconnexion</a></li></ul></div>
</div></div></nav>
<div class="container py-4">
<% if (locals.flashSuccess && flashSuccess.length) { %><div class="alert alert-success alert-dismissible fade show"><%= flashSuccess[0] %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
<% if (locals.flashError && flashError.length) { %><div class="alert alert-danger alert-dismissible fade show"><%= flashError[0] %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
