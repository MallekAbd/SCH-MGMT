<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Erreur | MadrastekDz</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"></head>
<body style="background:#f8fafc;font-family:Inter,sans-serif;min-height:100vh;display:flex;align-items:center">
<div class="container text-center py-5">
  <div class="display-1 fw-bold mb-3" style="color:#e2e8f0"><%= status || 500 %></div>
  <h2 class="fw-bold mb-2">Une erreur s'est produite</h2>
  <p class="text-muted mb-2"><%= message %></p>
  <% if (locals.stack) { %><pre class="text-start bg-light p-3 rounded small overflow-auto mx-auto" style="max-width:700px;max-height:300px"><%= stack %></pre><% } %>
  <a href="javascript:history.back()" class="btn btn-primary rounded-pill px-4 me-2 mt-3">Retour</a>
</div></body></html>
