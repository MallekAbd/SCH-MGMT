<%- include('../../partials/admin-shell-start') %>
<div class="d-flex justify-content-between align-items-center mb-3"><h4 class="fw-bold mb-0">Bibliothèque</h4><a href="/admin/library/new" class="btn btn-primary rounded-pill"><i class="fas fa-plus me-2"></i>Ajouter</a></div>
<div class="card border-0 shadow-sm mb-3"><div class="card-body py-2"><form method="GET" class="row g-2"><div class="col-md-5"><input type="text" name="search" class="form-control" placeholder="Rechercher..." value="<%= search %>"></div><div class="col-md-3"><select name="type" class="form-select"><option value="">Tous types</option><option value="file" <%= type==='file'?'selected':'' %>>Fichier</option><option value="video_link" <%= type==='video_link'?'selected':'' %>>Vidéo</option><option value="book" <%= type==='book'?'selected':'' %>>Livre</option></select></div><div class="col-md-2"><button class="btn btn-light w-100">Filtrer</button></div></form></div></div>
<div class="row g-3">
<% if (!items.length) { %><div class="col-12 text-center text-muted py-4">Aucun document</div><% } %>
<% items.forEach(i => { %><div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="badge bg-info-subtle text-info"><%= i.type %></span><span class="text-muted small"><%= i.downloads || 0 %> tél.</span></div><h6 class="fw-bold mt-2"><%= i.title %></h6><p class="text-muted small mb-2"><%= i.description || '' %></p><div class="small text-muted"><%= i.course?.name || '—' %> · <%= i.class?.name || '—' %></div><div class="mt-2"><a href="/admin/library/<%= i._id %>" class="btn btn-sm btn-light"><i class="fas fa-eye"></i></a><form action="/admin/library/<%= i._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Supprimer ?"><button class="btn btn-sm btn-light text-danger"><i class="fas fa-trash"></i></button></form></div></div></div></div><% }) %>
</div>
<%- include('../../partials/admin-shell-end') %>
