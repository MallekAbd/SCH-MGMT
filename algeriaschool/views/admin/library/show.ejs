<%- include('../../partials/admin-shell-start') %>
<h4 class="fw-bold mb-3"><%= item.title %></h4>
<div class="card border-0 shadow-sm"><div class="card-body">
<div class="row g-3 small"><div class="col-md-6"><strong>Type:</strong> <%= item.type %></div><div class="col-md-6"><strong>Auteur:</strong> <%= item.author || '—' %></div><div class="col-md-6"><strong>Téléchargements:</strong> <%= item.downloads || 0 %></div><div class="col-md-6"><strong>Tags:</strong> <%= (item.tags||[]).join(', ') %></div><div class="col-12"><strong>Description:</strong> <%= item.description || '—' %></div></div>
<% if (item.filePath) { %><a href="/uploads/library/<%= item.filePath %>" target="_blank" class="btn btn-primary mt-3"><i class="fas fa-download me-2"></i>Télécharger</a><% } %>
<% if (item.videoUrl) { %><a href="<%= item.videoUrl %>" target="_blank" class="btn btn-outline-primary mt-3"><i class="fas fa-play me-2"></i>Voir vidéo</a><% } %>
</div></div>
<%- include('../../partials/admin-shell-end') %>
