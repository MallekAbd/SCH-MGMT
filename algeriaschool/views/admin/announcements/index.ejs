<%- include('../../partials/admin-shell-start') %>
<div class="d-flex justify-content-between align-items-center mb-3"><h4 class="fw-bold mb-0">Annonces</h4><a href="/admin/announcements/new" class="btn btn-primary rounded-pill"><i class="fas fa-plus me-2"></i>Nouvelle</a></div>
<div class="row g-3">
<% if (!announcements.length) { %><div class="col-12 text-center text-muted py-4">Aucune annonce</div><% } %>
<% announcements.forEach(a => { %><div class="col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><h6 class="fw-bold"><%= a.isPinned?'📌 ':'' %><%= a.title %></h6><div><a href="/admin/announcements/<%= a._id %>/edit" class="btn btn-sm btn-light"><i class="fas fa-edit"></i></a><form action="/admin/announcements/<%= a._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Supprimer ?"><button class="btn btn-sm btn-light text-danger"><i class="fas fa-trash"></i></button></form></div></div><p class="text-muted small mb-2"><%= a.content.substring(0,150) %><%= a.content.length>150?'…':'' %></p><div class="text-muted" style="font-size:0.75rem"><%= a.author?.firstName %> · <%= new Date(a.createdAt).toLocaleDateString('fr-FR') %></div></div></div></div><% }) %>
</div>
<%- include('../../partials/admin-shell-end') %>
