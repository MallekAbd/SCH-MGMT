<%- include('../../partials/admin-shell-start') %>
<h4 class="fw-bold mb-3"><%= parent.user.firstName %> <%= parent.user.lastName %></h4>
<div class="card border-0 shadow-sm"><div class="card-body">
<div class="row g-3 small"><div class="col-md-6"><strong>Email:</strong> <%= parent.user.email %></div><div class="col-md-6"><strong>Téléphone:</strong> <%= parent.user.phone || '—' %></div><div class="col-md-6"><strong>Lien:</strong> <%= parent.relationship %></div><div class="col-md-6"><strong>Profession:</strong> <%= parent.profession || '—' %></div></div>
<h6 class="mt-3">Enfants</h6><% (parent.students || []).forEach(s => { %><div class="badge bg-light text-dark me-1"><%= s.firstName %> <%= s.lastName %></div><% }) %>
</div></div>
<%- include('../../partials/admin-shell-end') %>
