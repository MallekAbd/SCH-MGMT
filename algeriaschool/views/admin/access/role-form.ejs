<%- include('../../partials/admin-shell-start') %>
<h4 class="fw-bold mb-3"><%= role ? 'Modifier' : 'Nouveau' %> rôle</h4>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form action="<%= role ? `/admin/access/roles/${role._id}?_method=PUT` : '/admin/access/roles' %>" method="POST">
<div class="mb-3" style="max-width:400px"><label class="form-label">Nom du rôle *</label><input type="text" name="name" class="form-control" value="<%= role?.name || '' %>" required></div>
<h6 class="fw-bold mb-2">Permissions</h6>
<div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Module</th><% actions.forEach(a => { %><th class="text-center"><%= a %></th><% }) %></tr></thead><tbody>
<% modules.forEach(mod => { const existing = role?.permissions?.find(p => p.module === mod); %>
<tr><td class="fw-medium"><%= mod %></td><% actions.forEach(a => { %><td class="text-center"><input type="checkbox" name="permissions[<%= mod %>][<%= a %>]" class="form-check-input" <%= existing?.actions?.includes(a) ? 'checked' : '' %>></td><% }) %></tr>
<% }) %>
</tbody></table></div>
<div class="mt-3"><a href="/admin/access" class="btn btn-light me-2">Annuler</a><button type="submit" class="btn btn-primary px-4">Enregistrer</button></div>
</form></div></div>
<%- include('../../partials/admin-shell-end') %>
