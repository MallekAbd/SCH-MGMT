<%- include('../../partials/admin-shell-start') %>
<div class="d-flex justify-content-between align-items-center mb-3"><h4 class="fw-bold mb-0">Bulletin — <%= student.firstName %> <%= student.lastName %></h4><a href="/admin/grades/report-card/<%= student._id %>/pdf" class="btn btn-primary"><i class="fas fa-file-pdf me-2"></i>PDF</a></div>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<p class="text-muted">Classe: <%= student.currentClass?.name %></p>
<table class="table"><thead><tr><th>Matière</th><th class="text-end">Moyenne /20</th></tr></thead><tbody>
<% averages.forEach(a => { %><tr><td><%= a.course?.name %></td><td class="text-end fw-bold <%= a.average>=10?'text-success':'text-danger' %>"><%= a.average.toFixed(2) %></td></tr><% }) %>
<tr class="table-light"><td class="fw-bold">MOYENNE GÉNÉRALE</td><td class="text-end fw-bold fs-5 <%= overallAverage>=10?'text-success':'text-danger' %>"><%= overallAverage.toFixed(2) %> / 20</td></tr>
</tbody></table>
</div></div>
<%- include('../../partials/admin-shell-end') %>
