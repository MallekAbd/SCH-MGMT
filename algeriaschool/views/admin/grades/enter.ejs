<%- include('../../partials/admin-shell-start') %>
<h4 class="fw-bold mb-3">Saisie des notes — <%= exam.name %></h4>
<p class="text-muted small"><%= exam.course?.name %> · <%= exam.class?.name %> · /<%= exam.maxScore %></p>
<form action="/admin/grades/enter/<%= exam._id %>" method="POST">
<div class="card border-0 shadow-sm"><div class="card-body p-0"><table class="table mb-0"><thead class="bg-light"><tr><th class="ps-3">Élève</th><th>Note (/<%= exam.maxScore %>)</th></tr></thead><tbody>
<% students.forEach(s => { %><tr><td class="ps-3 fw-medium"><%= s.firstName %> <%= s.lastName %></td><td><input type="number" step="0.25" min="0" max="<%= exam.maxScore %>" name="grades[<%= s._id %>]" class="form-control form-control-sm" style="max-width:120px" value="<%= gradeMap[s._id.toString()] || '' %>"></td></tr><% }) %>
</tbody></table></div></div>
<div class="mt-3"><a href="/admin/grades/exams" class="btn btn-light me-2">Annuler</a><button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-2"></i>Enregistrer</button></div>
</form>
<%- include('../../partials/admin-shell-end') %>
