<%- include('../../partials/admin-shell-start') %>
<h4 class="fw-bold mb-3"><%= exam ? 'Modifier' : 'Nouvel' %> examen</h4>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form action="/admin/grades/exams" method="POST" class="row g-3">
<div class="col-md-6"><label class="form-label">Nom *</label><input type="text" name="name" class="form-control" required></div>
<div class="col-md-3"><label class="form-label">Type</label><select name="type" class="form-select"><% ['quiz','midterm','final','project','continuous'].forEach(t => { %><option value="<%= t %>"><%= t %></option><% }) %></select></div>
<div class="col-md-3"><label class="form-label">Trimestre</label><select name="term" class="form-select"><% ['T1','T2','T3','annual'].forEach(t => { %><option value="<%= t %>"><%= t %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label">Matière *</label><select name="course" class="form-select" required><% courses.forEach(c => { %><option value="<%= c._id %>"><%= c.name %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label">Classe *</label><select name="class" class="form-select" required><% classes.forEach(c => { %><option value="<%= c._id %>"><%= c.name %></option><% }) %></select></div>
<div class="col-md-3"><label class="form-label">Date</label><input type="date" name="date" class="form-control"></div>
<div class="col-md-3"><label class="form-label">Note max</label><input type="number" name="maxScore" class="form-control" value="20"></div>
<div class="col-md-3"><label class="form-label">Coefficient</label><input type="number" step="0.1" name="weight" class="form-control" value="1"></div>
<div class="col-md-3"><label class="form-label">Année</label><input type="text" name="academicYear" class="form-control" value="2024-2025"></div>
<div class="col-12"><a href="/admin/grades/exams" class="btn btn-light me-2">Annuler</a><button type="submit" class="btn btn-primary px-4">Créer</button></div>
</form></div></div>
<%- include('../../partials/admin-shell-end') %>
