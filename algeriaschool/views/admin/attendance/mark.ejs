<%- include('../../partials/admin-shell-start') %>
<h4 class="fw-bold mb-3">Présence — <%= cls.name %></h4>
<form action="/admin/attendance/mark/<%= cls._id %>" method="POST">
<div class="card border-0 shadow-sm mb-3"><div class="card-body"><label class="form-label">Date</label><input type="date" name="date" class="form-control" value="<%= today %>" required style="max-width:200px"></div></div>
<div class="card border-0 shadow-sm"><div class="card-body p-0"><table class="table mb-0"><thead class="bg-light"><tr><th class="ps-3">Élève</th><th>Statut</th><th>Note</th></tr></thead><tbody>
<% students.forEach(s => { %>
<tr>
<td class="ps-3 fw-medium"><%= s.firstName %> <%= s.lastName %></td>
<td><div class="d-flex gap-2"><% ['present','absent','late','excused'].forEach((st,i) => { %><div class="form-check"><input type="radio" name="records[<%= s._id %>][status]" value="<%= st %>" id="r<%= s._id %><%= st %>" class="form-check-input" <%= i===0?'checked':'' %>><label for="r<%= s._id %><%= st %>" class="form-check-label small"><%= {present:'Présent',absent:'Absent',late:'Retard',excused:'Excusé'}[st] %></label></div><% }) %></div></td>
<td><input type="text" name="records[<%= s._id %>][note]" class="form-control form-control-sm" placeholder="Note..."></td>
</tr>
<% }) %>
</tbody></table></div></div>
<div class="mt-3"><a href="/admin/attendance" class="btn btn-light me-2">Annuler</a><button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-2"></i>Enregistrer</button></div>
</form>
<%- include('../../partials/admin-shell-end') %>
