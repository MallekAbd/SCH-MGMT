<%- include('../../partials/admin-shell-start') %>
<h4 class="fw-bold mb-3">Rapport de présence</h4>
<div class="card border-0 shadow-sm mb-3"><div class="card-body"><form method="GET" class="row g-2"><div class="col-md-3"><select name="classId" class="form-select"><option value="">Toutes classes</option><% classes.forEach(c => { %><option value="<%= c._id %>" <%= classId===c._id.toString()?'selected':'' %>><%= c.name %></option><% }) %></select></div><div class="col-md-3"><input type="date" name="from" class="form-control" value="<%= from %>"></div><div class="col-md-3"><input type="date" name="to" class="form-control" value="<%= to %>"></div><div class="col-md-3"><button class="btn btn-primary w-100">Filtrer</button></div></form></div></div>
<div class="card border-0 shadow-sm"><div class="card-body p-0"><table class="table mb-0"><thead class="bg-light"><tr><th class="ps-3">Date</th><th>Classe</th><th>Total</th><th>Absents</th></tr></thead><tbody>
<% if (!attendances.length) { %><tr><td colspan="4" class="text-center text-muted py-4">Aucune donnée</td></tr><% } %>
<% attendances.forEach(a => { const absent = (a.records||[]).filter(r=>r.status==='absent').length; %>
<tr><td class="ps-3"><%= new Date(a.date).toLocaleDateString('fr-FR') %></td><td><%= a.class?.name %></td><td><%= (a.records||[]).length %></td><td><span class="badge bg-danger-subtle text-danger"><%= absent %></span></td></tr>
<% }) %>
</tbody></table></div></div>
<%- include('../../partials/admin-shell-end') %>
