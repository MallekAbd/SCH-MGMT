<%- include('../../partials/admin-shell-start') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0">Secteurs</h4>
  <a href="/admin/sectors/new" class="btn btn-primary rounded-pill"><i class="fas fa-plus me-2"></i>Nouveau secteur</a>
</div>
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="bg-light"><tr><th class="ps-3">Nom</th><th>Code</th><th>Description</th><th>Statut</th><th></th></tr></thead>
      <tbody>
        <% if (!sectors.length) { %><tr><td colspan="5" class="text-center text-muted py-4">Aucun secteur</td></tr><% } %>
        <% sectors.forEach(s => { %>
        <tr>
          <td class="ps-3 fw-medium"><%= s.name %></td>
          <td><%= s.code || '—' %></td>
          <td class="text-muted small"><%= s.description || '—' %></td>
          <td><% if (s.isActive) { %><span class="badge bg-success-subtle text-success">Actif</span><% } else { %><span class="badge bg-secondary-subtle text-secondary">Inactif</span><% } %></td>
          <td class="text-end pe-3">
            <a href="/admin/sectors/<%= s._id %>/edit" class="btn btn-sm btn-light"><i class="fas fa-edit"></i></a>
            <form action="/admin/sectors/<%= s._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Supprimer ?"><button class="btn btn-sm btn-light text-danger"><i class="fas fa-trash"></i></button></form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../../partials/admin-shell-end') %>
