<%- include('../../partials/admin-shell-start') %>
<h4 class="fw-bold mb-3"><%= message.subject || '(sans objet)' %></h4>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<div class="d-flex justify-content-between mb-3"><div><strong>De:</strong> <%= message.sender?.firstName %> <%= message.sender?.lastName %> (<%= message.sender?.role %>)</div><div class="text-muted small"><%= new Date(message.createdAt).toLocaleString('fr-FR') %></div></div>
<hr>
<div style="white-space: pre-wrap"><%= message.body %></div>
</div></div>
<a href="/admin/messages" class="btn btn-light mt-3"><i class="fas fa-arrow-left me-2"></i>Retour</a>
<%- include('../../partials/admin-shell-end') %>
