<%- include('../../partials/admin-shell-start') %>
<div class="d-flex justify-content-between align-items-center mb-3"><h4 class="fw-bold mb-0">Classes</h4><a href="/admin/classes/new" class="btn btn-primary rounded-pill"><i class="fas fa-plus me-2"></i>Nouvelle classe</a></div>
<div class="card border-0 shadow-sm"><div class="card-body p-0"><table class="table table-hover mb-0"><thead class="bg-light"><tr><th class="ps-3">Nom</th><th>Niveau</th><th>Année</th><th>Capacité</th><th>Salle</th><th></th></tr></thead><tbody>
<% if (!classes.length) { %><tr><td colspan="6" class="text-center text-muted py-4">Aucune classe</td></tr><% } %>
<% classes.forEach(c => { %><tr><td class="ps-3 fw-medium"><%= c.name %></td><td><%= c.level || '—' %></td><td><%= c.academicYear %></td><td><%= c.capacity %></td><td><%= c.room || '—' %></td><td class="text-end pe-3"><a href="/admin/classes/<%= c._id %>" class="btn btn-sm btn-light"><i class="fas fa-eye"></i></a><a href="/admin/classes/<%= c._id %>/edit" class="btn btn-sm btn-light"><i class="fas fa-edit"></i></a><form action="/admin/classes/<%= c._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Supprimer ?"><button class="btn btn-sm btn-light text-danger"><i class="fas fa-trash"></i></button></form></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../../partials/admin-shell-end') %>
