<%- include('../../partials/admin-shell-start') %>
<div class="d-flex justify-content-between align-items-center mb-3"><h4 class="fw-bold mb-0">Facture <%= invoice.invoiceNumber %></h4><a href="/admin/billing/invoices/<%= invoice._id %>/pdf" class="btn btn-primary"><i class="fas fa-file-pdf me-2"></i>PDF</a></div>
<div class="row g-3">
<div class="col-md-8"><div class="card border-0 shadow-sm"><div class="card-body p-4">
<div class="row mb-3"><div class="col-md-6"><strong>Élève:</strong> <%= invoice.student?.firstName %> <%= invoice.student?.lastName %></div><div class="col-md-6 text-md-end"><strong>Date:</strong> <%= new Date(invoice.createdAt).toLocaleDateString('fr-FR') %></div></div>
<table class="table"><thead class="bg-light"><tr><th>Description</th><th class="text-end">Montant</th></tr></thead><tbody>
<% (invoice.items||[]).forEach(i => { %><tr><td><%= i.description %></td><td class="text-end"><%= (i.amount||0).toLocaleString() %> DA</td></tr><% }) %>
<tr><td class="text-end fw-bold">Total</td><td class="text-end fw-bold fs-5"><%= (invoice.total||0).toLocaleString() %> DA</td></tr>
<tr><td class="text-end text-success">Payé</td><td class="text-end text-success"><%= (invoice.amountPaid||0).toLocaleString() %> DA</td></tr>
<tr><td class="text-end text-danger fw-bold">Solde</td><td class="text-end text-danger fw-bold"><%= (invoice.balance||0).toLocaleString() %> DA</td></tr>
</tbody></table>
<h6 class="mt-3">Paiements</h6>
<% if (!payments.length) { %><p class="text-muted small">Aucun paiement</p><% } %>
<% payments.forEach(p => { %><div class="border rounded p-2 mb-2 small"><strong><%= p.amount.toLocaleString() %> DA</strong> — <%= p.method %> · <%= new Date(p.paymentDate).toLocaleDateString('fr-FR') %></div><% }) %>
</div></div></div>
<div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body p-4">
<h6 class="fw-bold mb-3">Enregistrer un paiement</h6>
<form action="/admin/billing/payments" method="POST">
<input type="hidden" name="invoiceId" value="<%= invoice._id %>">
<div class="mb-2"><label class="form-label small">Montant</label><input type="number" name="amount" class="form-control" required></div>
<div class="mb-2"><label class="form-label small">Méthode</label><select name="method" class="form-select"><option value="cash">Espèces</option><option value="bank_transfer">Virement</option><option value="ccp">CCP</option><option value="baridibank">BaridiBank</option></select></div>
<div class="mb-2"><label class="form-label small">Référence</label><input type="text" name="reference" class="form-control"></div>
<div class="mb-2"><label class="form-label small">Notes</label><textarea name="notes" class="form-control" rows="2"></textarea></div>
<button type="submit" class="btn btn-success w-100">Enregistrer</button>
</form>
</div></div></div>
</div>
<%- include('../../partials/admin-shell-end') %>
