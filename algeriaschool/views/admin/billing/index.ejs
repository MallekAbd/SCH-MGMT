<%- include('../../partials/admin-shell-start') %>
<div class="d-flex justify-content-between align-items-center mb-3"><h4 class="fw-bold mb-0">Facturation</h4><div><a href="/admin/billing/fee-structures" class="btn btn-light me-2"><i class="fas fa-list me-2"></i>Structures</a><a href="/admin/billing/invoices/generate" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Générer factures</a></div></div>
<div class="row g-3 mb-3">
<% ['pending','partial','paid','overdue'].forEach(s => { const st = statsMap[s] || {count:0,total:0}; %>
<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small text-uppercase"><%= s %></div><div class="fw-bold fs-5"><%= st.count %></div><div class="text-muted small"><%= (st.total||0).toLocaleString() %> DA</div></div></div></div>
<% }) %>
</div>
<div class="card border-0 shadow-sm"><div class="card-body p-0"><table class="table table-hover mb-0"><thead class="bg-light"><tr><th class="ps-3">N°</th><th>Élève</th><th>Total</th><th>Solde</th><th>Statut</th><th>Échéance</th><th></th></tr></thead><tbody>
<% if (!invoices.length) { %><tr><td colspan="7" class="text-center text-muted py-4">Aucune facture</td></tr><% } %>
<% invoices.forEach(i => { %><tr><td class="ps-3 small"><%= i.invoiceNumber %></td><td class="fw-medium"><%= i.student?.firstName %> <%= i.student?.lastName %></td><td><%= (i.total||0).toLocaleString() %> DA</td><td class="<%= i.balance>0?'text-danger':'text-success' %>"><%= (i.balance||0).toLocaleString() %> DA</td><td><span class="badge bg-<%= {paid:'success',pending:'warning',partial:'info',overdue:'danger',cancelled:'secondary'}[i.status] %>-subtle text-<%= {paid:'success',pending:'warning',partial:'info',overdue:'danger',cancelled:'secondary'}[i.status] %>"><%= i.status %></span></td><td class="small"><%= i.dueDate ? new Date(i.dueDate).toLocaleDateString('fr-FR') : '—' %></td><td class="text-end pe-3"><a href="/admin/billing/invoices/<%= i._id %>" class="btn btn-sm btn-light"><i class="fas fa-eye"></i></a><a href="/admin/billing/invoices/<%= i._id %>/pdf" class="btn btn-sm btn-light"><i class="fas fa-file-pdf"></i></a></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../../partials/admin-shell-end') %>
