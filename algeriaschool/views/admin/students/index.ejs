<%- include('../../partials/admin-shell-start') %>
<div class="d-flex justify-content-between align-items-center mb-3"><h4 class="fw-bold mb-0">Élèves</h4><a href="/admin/students/new" class="btn btn-primary rounded-pill"><i class="fas fa-plus me-2"></i>Ajouter</a></div>
<div class="card border-0 shadow-sm mb-3"><div class="card-body py-2"><form action="/admin/students" method="GET" class="row g-2"><div class="col-md-4"><input type="text" name="search" class="form-control" placeholder="Rechercher..." value="<%= search %>"></div><div class="col-md-3"><select name="classId" class="form-select"><option value="">Toutes classes</option><% classes.forEach(c => { %><option value="<%= c._id %>" <%= classId === c._id.toString() ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div><div class="col-md-3"><select name="status" class="form-select"><option value="">Tous statuts</option><option value="active" <%= status==='active'?'selected':'' %>>Actif</option><option value="graduated" <%= status==='graduated'?'selected':'' %>>Diplômé</option></select></div><div class="col-md-2"><button class="btn btn-light w-100"><i class="fas fa-search me-2"></i>Filtrer</button></div></form></div></div>
<div class="card border-0 shadow-sm"><div class="card-body p-0"><table class="table table-hover mb-0"><thead class="bg-light"><tr><th class="ps-3">ID</th><th>Nom</th><th>Classe</th><th>Statut</th><th></th></tr></thead><tbody>
<% if (!students.length) { %><tr><td colspan="5" class="text-center text-muted py-4">Aucun élève</td></tr><% } %>
<% students.forEach(s => { %><tr><td class="ps-3 small text-muted"><%= s.studentId || '—' %></td><td class="fw-medium"><%= s.firstName %> <%= s.lastName %></td><td><%= s.currentClass?.name || '—' %></td><td><span class="badge bg-<%= s.status==='active'?'success':'secondary' %>-subtle text-<%= s.status==='active'?'success':'secondary' %>"><%= s.status %></span></td><td class="text-end pe-3"><a href="/admin/students/<%= s._id %>" class="btn btn-sm btn-light"><i class="fas fa-eye"></i></a><a href="/admin/students/<%= s._id %>/edit" class="btn btn-sm btn-light"><i class="fas fa-edit"></i></a><a href="/admin/students/<%= s._id %>/id-card" class="btn btn-sm btn-light" title="Carte"><i class="fas fa-id-card"></i></a></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../../partials/admin-shell-end') %>
