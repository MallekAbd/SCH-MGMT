<!DOCTYPE html>
<html lang="<%= locals.lang || 'fr' %>" dir="<%= locals.isRTL ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tableau de bord | MadrastekDz</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <%- include('../partials/admin-sidebar') %>
  <div class="admin-main">
    <%- include('../partials/admin-topbar') %>
    <div class="admin-content">
      <% if (locals.flashSuccess && flashSuccess.length) { %>
      <div class="alert alert-success alert-dismissible fade show"><%= flashSuccess[0] %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
      <% } %>

      <!-- Welcome Banner -->
      <div class="card border-0 mb-4" style="background:linear-gradient(135deg,#4f46e5,#06b6d4);border-radius:16px">
        <div class="card-body p-4 text-white">
          <h4 class="fw-bold mb-1">Bonjour, <%= user.firstName %> 👋</h4>
          <p class="mb-0 opacity-75">Voici le résumé de votre école aujourd'hui</p>
        </div>
      </div>

      <!-- KPI Cards -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="card border-0 shadow-sm h-100" style="border-radius:12px">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2" style="background:#eff6ff;width:44px;height:44px;display:flex;align-items:center;justify-content:center"><i class="fas fa-user-graduate" style="color:#3b82f6"></i></div>
                <div><div class="fw-bold fs-4 lh-1"><%= stats.totalStudents %></div><div class="text-muted small">Élèves</div></div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card border-0 shadow-sm h-100" style="border-radius:12px">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2" style="background:#f0fdf4;width:44px;height:44px;display:flex;align-items:center;justify-content:center"><i class="fas fa-chalkboard-teacher text-success"></i></div>
                <div><div class="fw-bold fs-4 lh-1"><%= stats.totalTeachers %></div><div class="text-muted small">Enseignants</div></div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card border-0 shadow-sm h-100" style="border-radius:12px">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2" style="background:#fffbeb;width:44px;height:44px;display:flex;align-items:center;justify-content:center"><i class="fas fa-chalkboard text-warning"></i></div>
                <div><div class="fw-bold fs-4 lh-1"><%= stats.totalClasses %></div><div class="text-muted small">Classes</div></div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card border-0 shadow-sm h-100" style="border-radius:12px">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2" style="background:#fef2f2;width:44px;height:44px;display:flex;align-items:center;justify-content:center"><i class="fas fa-file-invoice-dollar text-danger"></i></div>
                <div><div class="fw-bold fs-4 lh-1"><%= stats.pendingInvoices %></div><div class="text-muted small">Factures impayées</div></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Financial KPIs -->
      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <div class="card border-0 shadow-sm" style="border-radius:12px">
            <div class="card-body p-3 d-flex align-items-center gap-3">
              <div class="rounded-3 p-2" style="background:#f0fdf4;width:44px;height:44px;display:flex;align-items:center;justify-content:center"><i class="fas fa-arrow-up text-success"></i></div>
              <div><div class="fw-bold fs-5"><%= stats.monthlyRevenue.toLocaleString() %> DA</div><div class="text-muted small">Revenus ce mois</div></div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card border-0 shadow-sm" style="border-radius:12px">
            <div class="card-body p-3 d-flex align-items-center gap-3">
              <div class="rounded-3 p-2" style="background:#fef2f2;width:44px;height:44px;display:flex;align-items:center;justify-content:center"><i class="fas fa-arrow-down text-danger"></i></div>
              <div><div class="fw-bold fs-5"><%= stats.monthlyExpenses.toLocaleString() %> DA</div><div class="text-muted small">Dépenses ce mois</div></div>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <!-- Enrollment Chart -->
        <div class="col-lg-8">
          <div class="card border-0 shadow-sm h-100" style="border-radius:12px">
            <div class="card-body p-4">
              <h6 class="fw-semibold mb-3">Évolution des inscriptions</h6>
              <canvas id="enrollmentChart" height="120"></canvas>
            </div>
          </div>
        </div>

        <!-- Recent Payments -->
        <div class="col-lg-4">
          <div class="card border-0 shadow-sm h-100" style="border-radius:12px">
            <div class="card-body p-4">
              <h6 class="fw-semibold mb-3">Derniers paiements</h6>
              <% if (recentPayments && recentPayments.length) { %>
              <div class="d-flex flex-column gap-2">
                <% recentPayments.slice(0,6).forEach(p => { %>
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                  <div>
                    <div class="small fw-medium"><%= p.student ? `${p.student.firstName} ${p.student.lastName}` : 'Élève' %></div>
                    <div class="text-muted" style="font-size:0.7rem"><%= new Date(p.paymentDate).toLocaleDateString('fr-FR') %></div>
                  </div>
                  <span class="badge bg-success-subtle text-success"><%= p.amount.toLocaleString() %> DA</span>
                </div>
                <% }) %>
              </div>
              <% } else { %>
              <p class="text-muted small text-center mt-3">Aucun paiement récent</p>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Recent Announcements -->
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm" style="border-radius:12px">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-semibold mb-0">Annonces récentes</h6>
                <a href="/admin/announcements/new" class="btn btn-sm btn-primary rounded-pill px-3">+ Nouvelle</a>
              </div>
              <% if (recentAnnouncements && recentAnnouncements.length) { %>
              <div class="d-flex flex-column gap-2">
                <% recentAnnouncements.forEach(a => { %>
                <div class="p-2 rounded-2" style="background:#f8fafc">
                  <div class="fw-medium small"><%= a.isPinned ? '📌 ' : '' %><%= a.title %></div>
                  <div class="text-muted" style="font-size:0.7rem"><%= new Date(a.createdAt).toLocaleDateString('fr-FR') %></div>
                </div>
                <% }) %>
              </div>
              <% } else { %>
              <p class="text-muted small text-center mt-3">Aucune annonce</p>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Quick Links -->
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm" style="border-radius:12px">
            <div class="card-body p-4">
              <h6 class="fw-semibold mb-3">Raccourcis rapides</h6>
              <div class="row g-2">
                <% const links = [
                  {href:'/admin/students/new',icon:'user-plus',color:'primary',label:'Ajouter élève'},
                  {href:'/admin/teachers/new',icon:'chalkboard-teacher',color:'success',label:'Ajouter enseignant'},
                  {href:'/admin/attendance',icon:'clipboard-check',color:'info',label:'Marquer présences'},
                  {href:'/admin/billing',icon:'file-invoice-dollar',color:'warning',label:'Facturation'},
                  {href:'/admin/grades/exams/new',icon:'pen',color:'danger',label:'Créer examen'},
                  {href:'/admin/admissions',icon:'user-check',color:'secondary',label:'Admissions'},
                ]; %>
                <% links.forEach(l => { %>
                <div class="col-4">
                  <a href="<%= l.href %>" class="d-flex flex-column align-items-center gap-1 p-2 rounded-2 text-decoration-none" style="background:#f8fafc" onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='#f8fafc'">
                    <div class="rounded-2 p-2" style="background:var(--bs-<%= l.color %>-bg-subtle,#eff6ff)"><i class="fas fa-<%= l.icon %> text-<%= l.color %>"></i></div>
                    <span class="text-muted" style="font-size:0.65rem;text-align:center"><%= l.label %></span>
                  </a>
                </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="/js/admin.js"></script>
  <script>
    const trend = <%- enrollmentTrend %>;
    new Chart(document.getElementById('enrollmentChart'), {
      type: 'line',
      data: {
        labels: trend.map(t => t.month),
        datasets: [{
          label: 'Élèves inscrits',
          data: trend.map(t => t.count),
          fill: true,
          backgroundColor: 'rgba(79,70,229,0.08)',
          borderColor: '#4f46e5',
          tension: 0.4,
          pointBackgroundColor: '#4f46e5',
        }]
      },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: '#f1f5f9' } }, x: { grid: { display: false } } } }
    });
  </script>
</body>
</html>
