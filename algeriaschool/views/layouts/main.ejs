<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= isRTL ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | AlgeriaSchool</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
  <% if (isRTL) { %><link rel="stylesheet" href="/css/rtl.css"><% } %>
  <link rel="stylesheet" href="/css/public.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <% if (flashSuccess && flashSuccess.length) { %>
    <div class="alert alert-success alert-dismissible fade show m-0 rounded-0" role="alert">
      <%= flashSuccess[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (flashError && flashError.length) { %>
    <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0" role="alert">
      <%= flashError[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <%- body %>
  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/public.js"></script>
</body>
</html>
